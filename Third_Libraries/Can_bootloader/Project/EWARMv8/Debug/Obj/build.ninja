#Generating source browse information for project project


#Abbreviations
cc = E$:\IAR\common\bin\SourceIndexer.exe
ll = E$:\IAR\common\bin\PbdLink.exe
bd = E$:\IAR\common\bin\makeBrowseData.exe



#Rules
rule index
  depfile = $out.dep
  command = $cc -out=$out -f $in
rule link
  command = $ll -M $out $in
rule browsedata
  command = $bd $in -output  $out



#Build steps
build bsp.pbi : index bsp.xcl
build bsp_key.pbi : index bsp_key.xcl
build bsp_led.pbi : index bsp_led.xcl
build bsp_timer.pbi : index bsp_timer.xcl
build bsp_uart_fifo.pbi : index bsp_uart_fifo.xcl
build stm32f4xx_it.pbi : index stm32f4xx_it.xcl
build system_stm32f4xx.pbi : index system_stm32f4xx.xcl
build stm32f4xx_hal.pbi : index stm32f4xx_hal.xcl
build stm32f4xx_hal_cortex.pbi : index stm32f4xx_hal_cortex.xcl
build stm32f4xx_hal_dma.pbi : index stm32f4xx_hal_dma.xcl
build stm32f4xx_hal_flash.pbi : index stm32f4xx_hal_flash.xcl
build stm32f4xx_hal_flash_ex.pbi : index stm32f4xx_hal_flash_ex.xcl
build stm32f4xx_hal_gpio.pbi : index stm32f4xx_hal_gpio.xcl
build stm32f4xx_hal_rcc.pbi : index stm32f4xx_hal_rcc.xcl
build stm32f4xx_hal_tim.pbi : index stm32f4xx_hal_tim.xcl
build stm32f4xx_hal_tim_ex.pbi : index stm32f4xx_hal_tim_ex.xcl
build stm32f4xx_hal_uart.pbi : index stm32f4xx_hal_uart.xcl
build SEGGER_HardFaultHandler.pbi : index SEGGER_HardFaultHandler.xcl
build main.pbi : index main.xcl
build project_part0.pbi : link bsp.pbi bsp_key.pbi bsp_led.pbi bsp_timer.pbi
build project_part1.pbi : link bsp_uart_fifo.pbi stm32f4xx_it.pbi system_stm32f4xx.pbi stm32f4xx_hal.pbi
build project_part2.pbi : link stm32f4xx_hal_cortex.pbi stm32f4xx_hal_dma.pbi stm32f4xx_hal_flash.pbi stm32f4xx_hal_flash_ex.pbi
build project_part3.pbi : link stm32f4xx_hal_gpio.pbi stm32f4xx_hal_rcc.pbi stm32f4xx_hal_tim.pbi stm32f4xx_hal_tim_ex.pbi
build project_part4.pbi : link stm32f4xx_hal_uart.pbi SEGGER_HardFaultHandler.pbi main.pbi
build project.pbd : link project_part0.pbi project_part1.pbi project_part2.pbi project_part3.pbi project_part4.pbi
build project.pbw : browsedata project.pbd


